# IDE and editor settings
.idea/
.vscode/
*.iml

# Local knowledge-base / editor
/.obsidian/
/.codegraph/
/.superpowers/

# Local environment files
.env
.env.*
!.env.example

# Logs and temporary files
*.log
*.tmp
*.swp
*.swo
*~

# Build artifacts
target/
build/
dist/
out/

# Independently managed nested git repositories (not submodules).
# Parent tracks docs/scripts only; never commit nested-repo files into the parent.
/startech-mes-basic/
# Open-source MES reference (read-only). Implement only in startech-mes-basic.
/kuaigeyun-mes/

# RuoYi reference checkouts (read-only; never commit upstream source into the parent).
/RuoYi-Vue/
/RuoYi-Vue-springboot2/
/RuoYi-Vue-springboot3/
# Former Vue3 checkout path. Live Vue3 app is nested-repo `startech-mes-basic/startech-mes-front/`.
/RuoYi-Vue3-front/

# Linked git worktrees of nested repos (do not track checkouts).
/.worktrees/

# Linked git worktrees of nested repos (never track copies in the parent).
.worktrees/

# OS metadata
.DS_Store
Thumbs.db
Desktop.ini
