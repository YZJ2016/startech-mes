*.swo
*~

# Build artifacts
target/
build/
dist/
out/

# Independently managed nested git repository (not a submodule).
# Parent tracks docs/scripts only; commit MES code inside this directory.
/startech-mes-basic/

# RuoYi reference checkouts (read-only; never commit upstream source into the parent).
/RuoYi-Vue/
/RuoYi-Vue-springboot2/
/RuoYi-Vue-springboot3/
/RuoYi-Vue3-front/

# Linked git worktrees of nested repos (do not track checkouts).
/.worktrees/

# Linked git worktrees of nested repos (never track copies in the parent).
.worktrees/

# OS metadata
.DS_Store
Thumbs.db
Desktop.ini
